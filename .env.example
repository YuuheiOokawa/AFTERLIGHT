# Required on Vercel: pooled PostgreSQL connection URL from Neon / other PostgreSQL provider.
DATABASE_URL=
# Recommended on production: exact public origin, e.g. https://afterlight.vercel.app
APP_ORIGIN=
# Optional: local development uses PGlite if DATABASE_URL is empty.
LOCAL_DB_PATH=.local-db/afterlight
# Never set AFTERLIGHT_ALLOW_LOCAL_DB on Vercel. It exists only for local production-build testing.

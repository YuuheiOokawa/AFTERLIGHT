{
  "name": "afterlight-rpg",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "docs:generate": "node --import tsx scripts/export-api.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "pg": "^8.16.3",
    "@electric-sql/pglite": "0.5.9",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  }
}
